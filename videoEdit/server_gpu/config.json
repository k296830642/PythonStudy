{
  "reference_faces_dir": "faces",
  "input_dir": "input",
  "output_dir": "output",
  "model_cache_dir": ".models",
  "model_pack": "buffalo_l",
  "onnx_providers": ["CUDAExecutionProvider", "CPUExecutionProvider"],
  "require_gpu": true,
  "cuda_library_dirs": [
    "/ssd-data/ai/venv/lib/python3.12/site-packages/nvidia/cublas/lib",
    "/ssd-data/ai/venv/lib/python3.12/site-packages/nvidia/cudnn/lib",
    "/ssd-data/ai/venv/lib/python3.12/site-packages/nvidia/cuda_runtime/lib",
    "/ssd-data/ai/venv/lib/python3.12/site-packages/nvidia/cuda_nvrtc/lib",
    "/ssd-data/ai/venv/lib/python3.12/site-packages/nvidia/curand/lib",
    "/ssd-data/ai/venv/lib/python3.12/site-packages/nvidia/cufft/lib",
    "/usr/local/cuda/lib64",
    "/usr/local/cuda-13/lib64",
    "/usr/local/cuda-12/lib64",
    "/usr/lib/x86_64-linux-gnu"
  ],
  "recognition_mode": "balanced",
  "mode_thresholds": {
    "strict": 0.48,
    "balanced": 0.7,
    "sensitive": 0.36
  },
  "detection_size": 640,
  "detection_threshold": 0.55,
  "sample_fps": 2.0,
  "before_seconds": 2.0,
  "after_seconds": 1.0,
  "clip_overlap_strategy": "trim",
  "minimum_appearance_seconds": 0.8,
  "maximum_gap_seconds": 3.0,
  "minimum_face_size": 40,
  "mask_other_faces": true,
  "mask_image_path": "dama/cat_kawaii_blink.png",
  "mask_scale": 1.25,
  "mask_minimum_size": 24,
  "mask_alpha": 1.0,
  "insightface_detection_log": true,
  "detection_log_interval_seconds": 1.0,
  "detection_log_include_similarity": true,
  "target_tracking_enabled": true,
  "target_tracking_max_gap_frames": 5,
  "target_tracking_minimum_iou": 0.1,
  "target_tracking_maximum_center_distance_ratio": 0.6,
  "target_tracking_maximum_size_ratio": 1.75,
  "video_codec": "h264_nvenc",
  "video_preset": "p5",
  "video_cq": 19,
  "audio_codec": "aac",
  "overwrite_output": false
}
