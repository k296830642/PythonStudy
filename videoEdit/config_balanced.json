{
  "reference_faces_dir": "faces",
  "input_dir": "input",
  "output_dir": "output_2s_no_overlap",
  "model_dir": ".models",
  "detector_model": "face_detection_yunet_2023mar.onnx",
  "recognizer_model": "face_recognition_sface_2021dec.onnx",
  "detector_model_url": "https://github.com/opencv/opencv_zoo/raw/main/models/face_detection_yunet/face_detection_yunet_2023mar.onnx",
  "recognizer_model_url": "https://github.com/opencv/opencv_zoo/raw/main/models/face_recognition_sface/face_recognition_sface_2021dec.onnx",
  "recognition_mode": "balanced",
  "mode_thresholds": {
    "strict": 0.52,
    "balanced": 0.46,
    "sensitive": 0.40
  },
  "reference_match_strategy": "max",
  "sample_fps": 2.0,
  "before_seconds": 2.0,
  "after_seconds": 1.0,
  "clip_overlap_strategy": "trim",
  "annotate_matched_face": true,
  "annotation_show_similarity": true,
  "annotation_box_color_bgr": [0, 0, 255],
  "annotation_box_thickness": 3,
  "annotation_label_font_scale": 0.7,
  "annotation_label_thickness": 2,
  "mask_other_faces": true,
  "mask_image_path": "dama/cat_kawaii_blink.png",
  "mask_scale": 1.25,
  "mask_minimum_size": 24,
  "mask_alpha": 1.0,
  "insightface_detection_log": true,
  "detection_log_interval_seconds": 1.0,
  "detection_log_include_similarity": true,
  "target_tracking_enabled": true,
  "target_tracking_max_gap_frames": 5,
  "target_tracking_minimum_iou": 0.1,
  "target_tracking_maximum_center_distance_ratio": 0.6,
  "target_tracking_maximum_size_ratio": 1.75,
  "minimum_appearance_seconds": 0.5,
  "maximum_gap_seconds": 1.5,
  "minimum_face_size": 56,
  "detection_threshold": 0.80,
  "detection_nms_threshold": 0.3,
  "video_extensions": [".mp4", ".mov", ".mkv", ".avi"],
  "video_codec": "libx264",
  "video_crf": 18,
  "video_preset": "medium",
  "audio_codec": "aac",
  "overwrite_output": false
}
